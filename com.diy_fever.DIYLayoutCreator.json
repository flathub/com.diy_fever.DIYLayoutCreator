{
    "id": "com.diy_fever.DIYLayoutCreator",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "diylc",
    "rename-icon": "icon_512x512",
    "finish-args": [
        "--env=PATH=/app/jre/bin:/app/bin:/usr/bin",
        "--env=JAVA_HOME=/app/jre",
        "--env=JAVA=/app/jre/bin/java",
        "--share=ipc",
        "--socket=x11",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri",
        "--filesystem=home",
        "--persist=diylc"
    ],
    "modules": [
        {
            "name": "diylc",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh",
                "install -Dm644 diylc.jar -t /app/bin/",
                "install -Dm755 run.sh /app/bin/diylc",
                "install -Dm644 icons/icon_512x512.png -t /app/share/icons/hicolor/512x512/apps/",
                "install -Dm644 ${FLATPAK_ID}.metainfo.xml -t /app/share/metainfo/",
                "install -Dm644 ${FLATPAK_ID}.desktop -t /app/share/applications/"
            ],
            "post-install": [
                "ln -s /app/bin/xdg-open /app/bin/firefox"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bancika/diy-layout-creator/releases/download/v6.10.0/diylc-6.10.0-universal.zip",
                    "sha256": "630b80ed0158dfe1d93a4bc76e9fe65761f3046e22635e2aad816d27f03e00c6"
                },
                {
                    "type": "file",
                    "path": "com.diy_fever.DIYLayoutCreator.desktop"
                },
                {
                    "type": "file",
                    "path": "com.diy_fever.DIYLayoutCreator.metainfo.xml"
                }
            ]
        }
    ]
}
